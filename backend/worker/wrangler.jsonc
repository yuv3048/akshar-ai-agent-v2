{
 "$schema":"node_modules/wrangler/config-schema.json","name":"akshar-ai-agent","main":"src/index.ts","compatibility_date":"2026-10-22","compatibility_flags":["nodejs_compat"],
 "assets":{"directory":"../../frontend/dist","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*"]},
 "d1_databases":[{"binding":"DB","database_name":"akshar-db","database_id":"REPLACE_WITH_D1_DATABASE_ID","migrations_dir":"migrations"}],
 "kv_namespaces":[{"binding":"CACHE","id":"REPLACE_WITH_KV_NAMESPACE_ID"}],
 "vars":{"APP_NAME":"Akshar AI","MODEL_BASE_URL":"https://openrouter.ai/api/v1","CHAT_MODEL":"openai/gpt-4o-mini","VISION_MODEL":"openai/gpt-4o-mini","CORS_ORIGIN":"http://localhost:5173"}
}